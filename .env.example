# Configuración del proyecto. Para crear tu .env con secretos aleatorios:
#   node scripts/crear-env.mjs     (o: npm run env)
# El script rellena las variables que aquí están vacías. .env no se sube a git; este archivo sí.

# --- Puertos en tu máquina (dentro de los contenedores son siempre los mismos) ---
API_PORT=3001
WEB_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Secretos (los genera el script; no pongas aquí valores reales) ---
# Firma de las sesiones del administrador.
JWT_SECRET=
# Cifrado (AES-256) y búsqueda (HMAC) de los correos y teléfonos de los clientes.
# Si se pierden, esos datos no se pueden recuperar.
CLIENTES_ENC_KEY=
CLIENTES_HMAC_KEY=

# --- Administrador inicial (se crea al arrancar si la base no tiene ninguno) ---
ADMIN_EMAIL=admin@cafeteria.local
ADMIN_PASSWORD=

# --- Correo ---
# Remitente de las ofertas. En desarrollo los correos no salen: los atrapa Mailpit.
MAIL_FROM=Cafetería <ofertas@cafeteria.local>

# --- Solo para desarrollo SIN Docker (npm run start:dev). docker compose los ignora ---
DATABASE_URL=file:./dev.db
SMTP_HOST=localhost
SMTP_PORT=1025
PUBLIC_WEB_URL=http://localhost:3000

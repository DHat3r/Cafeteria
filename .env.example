# Copia este archivo a .env (cp .env.example .env) si quieres cambiar los puertos.
# Es opcional: docker compose ya usa estos mismos valores por defecto.
# .env no se sube a git; este archivo sí.

# Puerto de la API en tu maquina (dentro del contenedor siempre es 3001)
API_PORT=3001

# Puerto del frontend en tu maquina (dentro del contenedor siempre es 3000)
WEB_PORT=3000

# Puerto SMTP de Mailpit (el que usa la app para enviar correos de prueba)
MAILPIT_SMTP_PORT=1025

# Puerto de la bandeja web de Mailpit (http://localhost:8025)
MAILPIT_UI_PORT=8025
